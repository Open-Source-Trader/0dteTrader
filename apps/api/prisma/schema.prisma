// 0dteTrader data model — see docs/ARCHITECTURE.md §5.
//
// Notes:
// - `User.email` is a plain String with a unique index; case-insensitivity is
//   enforced at the application layer (emails are lowercased before any
//   read/write) instead of the citext extension so no extension is required.
// - `WebullCredential` stores AES-256-GCM encrypted fields. Each enc_* column
//   holds a self-contained blob: iv (12 bytes) || authTag (16 bytes) ||
//   ciphertext. A single shared iv/auth_tag column pair cannot safely hold
//   per-field GCM parameters without reusing nonces, so each field carries its
//   own parameters (random 12-byte IV per field per write — IVs are never
//   reused).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                       @id @default(uuid()) @db.Uuid
  email             String                       @unique
  passwordHash      String
  tradingDisabled   Boolean                      @default(false)
  tradingMode       String                       @default("live")
  /// Broker the user trades through ('webull' | 'alpaca'); default webull.
  tradingProvider   String                       @default("webull")
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  credentials       WebullCredential[]
  refreshTokens     RefreshToken[]
  orderAudits       OrderAudit[]
  webullApiTokens   WebullApiToken[]
  brokerCredentials BrokerCredential[]
  brokerApiTokens   BrokerApiToken[]
  brokerConnections BrokerConnection[]
  tradeOrders       TradeOrder[]
  chartOrders       ChartOrder[]
  bracketGroups     BracketGroup[]
  deviceTokens      DeviceToken[]
  pushDeliveries    PushDelivery[]
  webhookInbox      WebhookInbox[]
  userEvents        UserEvent[]
  discordSettings   DiscordNotificationSettings?
  discordDeliveries DiscordDelivery[]
  legalAcceptances  LegalAcceptance[]

  @@map("users")
}

model WebullCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "live" | "practice" — one credential set per environment per user.
  environment  String   @default("live")
  encAppKey    Bytes
  encAppSecret Bytes
  // Null until discovered via GET /openapi/account/list (the official flow:
  // the user supplies only app key/secret; the account id is fetched).
  encAccountId Bytes?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, environment])
  @@map("webull_credentials")
}

// Persisted Webull OpenAPI access tokens (encrypted) so restarts reuse the
// existing token instead of re-creating one — every create on production
// triggers SMS re-verification in the user's Webull app. One row per
// (user, environment), mirroring webull_credentials.
model WebullApiToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "live" | "practice"
  environment String   @default("live")
  encToken    Bytes
  expiresAt   DateTime
  // NORMAL | PENDING (awaiting in-app 2FA verification)
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, environment])
  @@map("webull_api_tokens")
}

// Provider-agnostic credential store. `encSecrets` is one AES-256-GCM blob of
// the provider-specific secret JSON ({appKey,appSecret,accountId} for Webull;
// {apiKey,apiSecret} for Alpaca). One row per (user, provider, environment).
model BrokerCredential {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String   @default("webull")
  environment       String   @default("live")
  encSecrets        Bytes
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  /// SnapTrade Personal client ID, stored in plaintext (not a secret on its
  /// own — the consumerKey is) so the webhook receiver can resolve which app
  /// user a `clientId` in an inbound webhook payload belongs to without
  /// decrypting every stored SnapTrade credential. Null for other providers.
  snaptradeClientId String?

  @@unique([userId, provider, environment])
  /// Postgres treats each NULL as distinct under a unique index, so this only
  /// constrains rows that actually have a snaptradeClientId (i.e. SnapTrade
  /// rows) — one clientId can't be saved under two different app users or two
  /// environments, which the webhook receiver's findFirst lookup depends on.
  @@unique([provider, snaptradeClientId])
  @@map("broker_credentials")
}

// Encrypted-at-rest broker access tokens (Webull only today; Alpaca keys are
// long-lived and need none). Mirrors webull_api_tokens but provider-scoped.
model BrokerApiToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String   @default("webull")
  environment String   @default("live")
  encToken    Bytes
  expiresAt   DateTime
  status      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider, environment])
  @@map("broker_api_tokens")
}

// OAuth connection metadata for provider-agnostic brokerage connections.
// **Per-user, per-environment:** one row per (userId, provider, environment)
// — a SnapTrade user can have an independent live and practice connection.
// Tracks the SnapTrade connection id and the account ids surfaced by that
// connection so webhooks can update them and the UI can present an account
// picker. The `userId` FK has `onDelete: Cascade` so removing a user removes
// all their connections.
model BrokerConnection {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String   @default("snaptrade")
  environment       String   @default("live")
  connectionId      String
  accountIds        String[]
  selectedAccountId String?
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, provider, environment])
  @@map("broker_connections")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// One row per broker order, kept current as order-update events arrive
// (fills land asynchronously). Feeds the trade-history endpoint.
model TradeOrder {
  // Internal identity. Broker and client order ids are only unique inside a
  // user/provider/environment/account scope and therefore cannot be the PK.
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String    @default("webull")
  accountId        String    @default("default")
  brokerOrderId    String?
  clientOrderId    String?
  contractSymbol   String
  assetClass       String
  // "live" | "practice" — tradingMode in effect when the order was recorded.
  environment      String    @default("live")
  side             String
  quantity         Float
  // Broker-reported executed quantity (partial fills); null when the broker
  // gives only the order quantity.
  filledQuantity   Float?
  orderType        String
  limitPrice       Float?
  filledPrice      Float?
  // When the order's FIRST execution happened: the broker's execution
  // timestamp when reported, else when the fill was observed. Anchors
  // Position.openedAt. Null for rows recorded before this column existed —
  // readers fall back to placedAt.
  filledAt         DateTime?
  // Cumulative executed quantity RECORDED so far — the watermark concurrent
  // recorders (webhook + poller, across API instances) claim fill increments
  // against, advanced only by compare-and-set in OrdersService. Deliberately
  // independent of `status`: a stale status regression must never reset it.
  executedQuantity Float     @default(0)
  // Price of the UNDERLYING when the order was placed. Feeds the chart's entry
  // line, which is drawn on the underlying's scale, not the contract's. Null
  // for orders placed before this was recorded.
  underlyingPrice  Float?
  status           String
  placedAt         DateTime
  updatedAt        DateTime  @updatedAt

  executions TradeOrderExecution[]

  @@unique([userId, provider, environment, accountId, brokerOrderId])
  @@unique([userId, provider, environment, accountId, clientOrderId])
  @@index([userId, placedAt])
  @@map("trade_orders")
}

// One OBSERVATION of a TradeOrder's cumulative fill state. The order row keeps
// only its latest cumulative state, which loses how partial fills interleave
// across orders; the position replay works from these instead.
//
// Rows are snapshots, not increments, because at write time only the snapshot
// is knowable-correct: a LOWER cumulative can still arrive afterwards (delayed
// webhook, out-of-order poll), and an increment derived against the wrong
// neighbour is wrong forever. Increments are the differences between
// consecutive snapshots, derived when the replay reads them.
//
// Two older row shapes are still read: rows written as increments before this
// table stored snapshots carry `quantity`/`price` and no `avgPrice`, and the
// oldest carry no `cumulative` either. The replay reconstructs a snapshot from
// either shape.
model TradeOrderExecution {
  id         String     @id @default(uuid()) @db.Uuid
  orderId    String     @db.Uuid
  order      TradeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // The order's cumulative executed quantity as of this observation.
  // Null only on rows predating the column; Postgres treats unique-index
  // NULLs as distinct, so those rows are unconstrained by the index below.
  cumulative Float?
  // The broker's cumulative AVERAGE price over `cumulative` — the other half
  // of the observation, and what makes the increment derivable at read time.
  avgPrice   Float?
  // The pre-derived increment of the older shape: positive executed delta and
  // its price. Never written for snapshot rows.
  quantity   Float?
  price      Float?
  executedAt DateTime
  createdAt  DateTime   @default(now())

  @@unique([orderId, cumulative])
  @@index([orderId])
  @@map("trade_order_executions")
}

// A resting order line drawn on the chart. The broker never receives it: the
// trigger is watched against the UNDERLYING's price, and a crossing fires an
// ordinary mid/market option order through TradingService. Both the client and
// the server-side watcher are armed; they converge because the fire uses a
// deterministic idempotency key derived from `id`.
model ChartOrder {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "live" | "practice" — a line armed in practice must never fire against live.
  environment    String        @default("live")
  // Chart symbol whose price arms the trigger (SPY), not the contract.
  underlying     String
  triggerPrice   Float
  // Underlying price when the line was armed (created, or moved). Firing tests
  // the segment armPrice → last, so a gap, a restart, or a watcher failover
  // cannot step over a level unnoticed.
  armPrice       Float
  side           String
  quantity       Int
  // Execution type used when the level is crossed. Owned by the line, not by
  // the trade panel, and flippable from the chart.
  orderType      String
  // "limit" | "target" | "stop"
  kind           String
  optionType     String
  expiration     String
  strike         Float
  contractSymbol String
  // Shared by the target and stop of one position; firing either cancels the other.
  ocoGroupId     String?       @db.Uuid
  bracketGroup   BracketGroup? @relation(fields: [ocoGroupId], references: [id], onDelete: Cascade)
  // "working" | "triggered" | "filled" | "cancelled" | "failed" | "expired"
  status         String        @default("working")
  // The contract's expiration close; past this the line expires unfilled.
  expiresAt      DateTime
  triggeredAt    DateTime?
  brokerOrderId  String?
  lastError      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([ocoGroupId, kind])
  @@index([userId, status])
  // The watcher's sweep: every working line, grouped by what it must quote.
  @@index([status, environment, underlying])
  @@index([ocoGroupId])
  @@map("chart_orders")
}

// Durable identity and state machine for an OCO bracket. The group is claimed
// before either leg reaches the broker; a lease lets another instance recover
// a process death around placement by consulting the idempotent order audit.
model BracketGroup {
  id                String       @id @db.Uuid
  userId            String       @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  environment       String
  accountId         String
  contractSymbol    String
  closeSide         String
  protectedQuantity Int
  status            String       @default("working")
  fireLegId         String?      @db.Uuid
  leaseOwnerId      String?
  leaseExpiresAt    DateTime?
  lastError         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  orders            ChartOrder[]

  @@index([status, leaseExpiresAt])
  @@index([userId, environment, status])
  @@map("bracket_groups")
}

model OrderAudit {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  idempotencyKey String?
  request        Json
  response       Json?
  status         String
  createdAt      DateTime @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@map("order_audits")
}

model OptionsAnalyticsSnapshotRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  symbol             String
  expiration         String
  observedAt         DateTime
  settlementAt       DateTime
  bucket             DateTime
  // "core" | "viewed"; enforced by a database check constraint.
  captureReason      String
  // 1 | 5; enforced by a database check constraint.
  resolutionMinutes  Int
  calculationVersion String
  input              Json
  output             Json
  quality            Json
  createdAt          DateTime @default(now())

  @@unique([symbol, expiration, bucket, calculationVersion, resolutionMinutes], map: "options_analytics_snapshot_identity_key")
  @@index([resolutionMinutes, bucket])
  @@map("options_analytics_snapshots")
}

// A device registered for push notifications. `token` is globally unique —
// re-registering an existing token moves it to the registering account (the
// device changed users, and only its current owner should be notified). Rows
// are pruned when APNs reports the token dead.
model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

// One row per device and notifiable event. Delivery is leased so a process
// death between claim and APNs send is recoverable, and one failing device can
// retry without re-alerting siblings that already received the event.
model PushDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key            String
  deviceToken    String
  environment    String
  title          String
  body           String
  status         String    @default("pending")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  leaseOwnerId   String?
  leaseExpiresAt DateTime?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, key, deviceToken])
  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@index([createdAt])
  @@map("push_deliveries")
}

// Provider webhook inbox. HTTP acknowledgement happens only after this row
// commits; workers then claim rows with compare-and-set leases.
model WebhookInbox {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  webhookId      String
  environment    String
  accountId      String?
  eventType      String
  payload        Json
  status         String    @default("pending")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  leaseOwnerId   String?
  leaseExpiresAt DateTime?
  lastError      String?
  failureStage   String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([provider, webhookId])
  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@map("webhook_inbox")
}

// Durable, resumable application events. `ordinal` is the shared polling
// cursor; `sequence` is monotone inside one user's stream and is what clients
// persist across reconnects.
model UserEvent {
  ordinal   BigInt   @id @default(autoincrement())
  id        String   @unique @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sequence  Int
  dedupeKey String?
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@unique([userId, sequence])
  @@unique([userId, dedupeKey])
  @@index([userId, sequence])
  @@map("user_events")
}

model DiscordNotificationSettings {
  userId        String   @id @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  encWebhookUrl Bytes?
  enabled       Boolean  @default(false)
  includePnl    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("discord_notification_settings")
}

model DiscordDelivery {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key         String
  status      String
  attempts    Int       @default(0)
  lastError   String?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, key])
  @@index([createdAt])
  @@map("discord_deliveries")
}

model LegalAcceptance {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   String
  version    String
  acceptedAt DateTime @default(now())

  @@unique([userId, document, version])
  @@index([userId, document])
  @@map("legal_acceptances")
}

model ScheduledJobLease {
  name      String   @id
  ownerId   String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("scheduled_job_leases")
}

/// Server-generated fallback secrets for zero-config self-hosted deploys.
/// Only consulted when the corresponding env var is absent.
model RuntimeSecret {
  name      String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("runtime_secrets")
}
