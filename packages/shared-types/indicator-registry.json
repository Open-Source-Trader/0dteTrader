    {
      "id": "macd",
      "displayName": "MACD",
      "pane": "subpane",
      "requiresL2": false,
      "parameters": {
        "fastPeriod": {
          "id": "fastPeriod",
          "label": "Fast Period",
          "kind": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 12
        },
        "slowPeriod": {
          "id": "slowPeriod",
          "label": "Slow Period",
          "kind": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 26
        },
        "signalPeriod": {
          "id": "signalPeriod",
          "label": "Signal Period",
          "kind": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 9
        }
      },
      "constraints": [
        {
          "kind": "less_than",
          "left": "fastPeriod",
          "right": "slowPeriod",
          "message": "Fast period must be less than slow period."
        }
      ],
      "defaultSettings": {
        "enabled": false,
        "parameters": { "fastPeriod": 12, "slowPeriod": 26, "signalPeriod": 9 }
      },
      "styleTokens": {
        "macd": "indicator.macd.value",
        "signal": "indicator.macd.signal",
        "histogram": "indicator.macd.histogram"
      },
      "geometry": {
        "kind": "multi_line",
        "series": [
          {
            "id": "macd",
            "label": "MACD",
            "styleToken": "indicator.macd.value",
            "renderAs": "line"
          },
          {
            "id": "signal",
            "label": "Signal",
            "styleToken": "indicator.macd.signal",
            "renderAs": "line"
          },
          {
            "id": "histogram",
            "label": "Histogram",
            "styleToken": "indicator.macd.histogram",
            "renderAs": "histogram"
          }
        ]
      }
    },
