{
  "version": 1,
  "maxSubPanes": 2,
  "paneLimitMessage": "You can display up to 2 indicator panes.",
  "indicators": [
    {
      "id": "sma",
      "displayName": "Simple Moving Average",
      "pane": "overlay",
      "requiresL2": false,
      "parameters": {
        "period": {
          "id": "period",
          "label": "Period",
          "kind": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 20
        }
      },
      "defaultSettings": { "enabled": false, "parameters": { "period": 20 } },
      "styleTokens": { "value": "indicator.sma.value" },
      "geometry": {
        "kind": "line",
        "series": [{ "id": "value", "label": "SMA", "styleToken": "indicator.sma.value" }]
      }
    },
