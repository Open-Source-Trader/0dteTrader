{
  "name": "@0dtetrader/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared DTO/domain types for 0dteTrader (mirrors docs/openapi.yaml)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "indicator-registry.json",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "npm run build && node --test test/*.test.mjs && npm run test:types",
    "test:types": "tsc --ignoreConfig --noEmit --strict --target ES2021 --module node16 --moduleResolution node16 --skipLibCheck test/contracts.compile.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.8.0",
    "typescript": "~7.0.2"
  }
}
